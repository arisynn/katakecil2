{
  "name": "katakecil-web",
  "private": true,
  "repository": "arisynn/katakecil2",
  "scripts": {
    "test": "pnpm --filter @readest/readest-app test",
    "lint": "pnpm --filter @readest/readest-app lint",
    "check:eink-identity": "node scripts/check-eink-identity-sync.mjs",
    "dev-web": "pnpm --filter @readest/readest-app dev-web",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "pnpm --filter @readest/readest-app dev-web",
    "build": "pnpm --filter @readest/readest-app setup-vendors && pnpm --filter @readest/readest-app build-web",
    "start": "pnpm --filter @readest/readest-app start-web",
    "test:publisher": "python3 -m unittest discover -s tools/katakecil-publisher/tests -v"
  },
  "packageManager": "pnpm@11.1.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@sindresorhus/tsconfig": "^6.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^16.2.7",
    "typescript": "^5"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  }
}
